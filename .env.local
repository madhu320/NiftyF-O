# Environment Variables Configuration
# Copy this file to .env.local and fill in your credentials
# IMPORTANT: .env.local should NEVER be committed to git

# ============================================================================
# ALICE BLUE (ANT) - Indian Broker
# Get credentials: https://www.aliceblueonline.com/
# API Docs: https://www.aliceblueonline.com/api-docs
# ============================================================================

# Your Alice Blue API Key
ALICE_API_KEY=W6329sgnmx

# Your Alice Blue API Secret
ALICE_API_SECRET=6TxaOUsKyjhhHo6MokD4qgfQfcdViTMg6rT5CZilA5rxGcG6tUhOdWfIN88s7cH8KiM34vCXw2LwLJ7GszK1HrBRWdmYSVj1h026

# Your Alice Blue User ID
ALICE_USER_ID=1902101

# Optional: Alice Blue password for 2FA
ALICE_PASSWORD=your_alice_password_here

# URL to redirect users back to your Expo Go mobile app after successful login
# Note: Change 192.168.1.10 to your computer's actual IPv4 address!
ALICE_FRONTEND_REDIRECT_URL=exp://192.168.1.10:8081/

# Enable Alice Blue integration
ALICE_ENABLED=true

# ============================================================================
# ZERODHA (Alternative to Alice)
# Get credentials: https://zerodha.com/
# API Docs: https://kite.trade/docs/
# ============================================================================

# Your Zerodha API Key (from app.zerodha.com)
ZERODHA_API_KEY=your_zerodha_api_key_here

# Your Zerodha API Secret
ZERODHA_API_SECRET=your_zerodha_api_secret_here

# Your Zerodha Public Token (get from auth flow)
ZERODHA_PUBLIC_TOKEN=your_zerodha_public_token_here

# Your Zerodha User ID
ZERODHA_USER_ID=your_zerodha_user_id_here

# Enable Zerodha integration
ZERODHA_ENABLED=false

# ============================================================================
# UPSTOX (Alternative to Alice/Zerodha)
# Get credentials: https://upstox.com/
# API Docs: https://upstox.com/developer/
# ============================================================================

# Your Upstox API Key
UPSTOX_API_KEY=your_upstox_api_key_here

# Your Upstox API Secret
UPSTOX_API_SECRET=your_upstox_api_secret_here

# Upstox OAuth redirect URL (usually your app URL)
UPSTOX_REDIRECT_URL=http://localhost:3000/auth/callback

# Enable Upstox integration
UPSTOX_ENABLED=false

# ============================================================================
# ALPACA (US Broker - not recommended for NSE trading)
# Get credentials: https://alpaca.markets/
# API Docs: https://docs.alpaca.markets/
# ============================================================================

# Your Alpaca API Key
ALPACA_API_KEY=your_alpaca_api_key_here

# Your Alpaca API Secret
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Alpaca API Base URL
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Enable Alpaca integration
ALPACA_ENABLED=false

# ============================================================================
# ACTIVE BROKER SELECTION
# Choose which broker to use: alice, zerodha, upstox, alpaca
# ============================================================================

# Set to one of: alice, zerodha, upstox, alpaca
ACTIVE_BROKER=alice

# ============================================================================
# SECURITY & ENCRYPTION
# Used to encrypt/decrypt API keys in database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# Encryption master key for storing credentials securely
ENCRYPTION_KEY=generate_this_and_paste_here

# Encryption algorithm (do not change)
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL connection string (if using database for storing credentials)
DATABASE_URL=postgresql://user:password@localhost:5432/trading_db

# ============================================================================
# API SERVER
# ============================================================================

# API Server port
PORT=3000

# API Server host
HOST=0.0.0.0

# Node environment
NODE_ENV=development

# ============================================================================
# MOBILE APP
# ============================================================================

# Expo public API URL (for mobile app) 
# Note: Change 192.168.1.10 to your computer's actual IPv4 address!
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api

# ============================================================================
# LOGGING
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Fill in your Alice Blue credentials (or Zerodha/Upstox)
#
# 3. Generate encryption key:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 4. Paste encryption key in ENCRYPTION_KEY above
#
# 5. Set ACTIVE_BROKER to alice, zerodha, upstox, or alpaca
#
# 6. Make sure ACTIVE_BROKER_ENABLED=true for your chosen broker
#
# 7. Start the server:
#    npm run dev
#
# 8. Verify integration:
#    curl http://localhost:3000/api/ant/positions
#
# 9. IMPORTANT: Never commit .env.local to git!
#    It's already in .gitignore

# ============================================================================
# FOR DEPLOYMENT (Vercel, Render, AWS, etc)
# ============================================================================

# Instead of .env.local file, set these as environment secrets in your deployment:
#
# 1. Vercel: Settings → Environment Variables
# 2. Render: Environment → Custom Domains
# 3. AWS: Systems Manager → Parameter Store
# 4. GitHub: Secrets → Actions Secrets
#
# Same keys and values, just set as deployment environment variables
