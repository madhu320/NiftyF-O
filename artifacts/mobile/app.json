      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cfe65b03-387b-4fa6-8ee7-11b54edf0d5e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cfe65b03-387b-4fa6-8ee7-11b54edf0d5e"
    }
  }
